{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roaster-me",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roaster-me-db",
      "database_id": "86f1d8cf-1aec-42ef-82a7-62da5db9d4d9",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    // remove when RESEND_API_KEY is set
    "BETTER_AUTH_URL": "https://roaster-me.logan-lee.workers.dev",
    // public OAuth client identifier — safe to commit; GOOGLE_CLIENT_SECRET is a Worker secret
    "GOOGLE_CLIENT_ID": "247984044046-odt3hsmtj0dkbd7ie6ndavtii6i3ct8r.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}
