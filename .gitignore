# local-state backups (wrangler D1 session tokens, dist snapshots) — never commit
.wrangler.bak*/
*.bak/

# The repo root is not a scratch directory. Screenshots from visual checks and one-off Playwright
# probes both kept landing here and getting committed — six screenshots were already listed by
# hand before this became a rule. Real scripts live in scripts/, real image assets in web/public/.
# Both patterns are root-only, so web/public/icons/*.png and scripts/*.mjs are unaffected.
# Deliberate exception: git add -f.
/*.png
/*.mjs

# venv/build artifacts pending manual removal (sandbox rm -rf blocked) — see task-1-report.md
/.expo/
/.yarn/
/android/
/ios/
expo-env.d.ts
EK_flightMapping.json
/lib/
pyvenv.cfg
/include/
/bin/
/path/
/python/
.firecrawl/

# scripts/fetch-schedules.mjs local state - resume progress + the SQL it writes before an
# --apply run; both are regenerated locally, never meant to be committed.
/scripts/.fetch-progress.json
/scripts/.fetch-schedules-tmp.sql

# One-off diagnostic scratch files, never part of the suite
worker/test/**/__*.test.ts
scripts/.probe-*.mjs
.verify-*.mjs
*.test.ts.bak
