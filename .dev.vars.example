# Copy to .dev.vars (gitignored) for local `wrangler dev`. Never commit real secrets here.

# better-auth session/cookie signing secret. Any non-empty string works locally.
BETTER_AUTH_SECRET=test-secret-not-for-production-0000000

# When RESEND_API_KEY is unset, OTPs are captured in-memory instead of emailed —
# printed to the worker console and readable via getLastDevOtp(). Remove this once
# RESEND_API_KEY is set.
DEV_OTP_FALLBACK=true

# Overrides wrangler.jsonc's production BETTER_AUTH_URL for local dev — better-auth
# uses this both as its baseURL and as the trusted origin for CSRF/origin checks, so
# without this override `wrangler dev` on localhost gets "Invalid origin" on sign-in.
BETTER_AUTH_URL=http://localhost:8787

# Enables GET /api/__e2e/last-otp?email=..., a test-only route the Playwright suite
# (e2e/) uses to fetch the dev-fallback OTP without a real inbox. Required to run
# `pnpm test:e2e` against `wrangler dev`. NEVER set this in wrangler.jsonc `vars` —
# it must only ever exist in .dev.vars, the e2e runner's env, and vitest bindings, so
# the route 404s in every deployed environment.
E2E_TEST_MODE=true

# Google OAuth client ID — also set as a public var in wrangler.jsonc for prod.
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# Google OAuth client secret — uploaded as a Worker secret in prod
# (`wrangler secret put GOOGLE_CLIENT_SECRET`). Never commit the real value.
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>

# VAPID keypair for Web Push, LOCAL DEV ONLY — generate with
# `node scripts/generate-vapid.mjs --local` and paste both values below. This MUST be a
# DIFFERENT keypair from prod: prod's public half is a wrangler.jsonc var and its private
# half is a Worker secret uploaded via `node scripts/generate-vapid.mjs --put` (never
# written to any file). Never commit real values here.
VAPID_PUBLIC_KEY=<your-local-dev-vapid-public-key>
VAPID_PRIVATE_KEY=<your-local-dev-vapid-private-key>

# Local convenience: this address always receives the fixed code 123123 instead of a random
# one, so signing in during development doesn't mean reading the OTP out of the server log.
# Only takes effect when DEV_OTP_FALLBACK=true, which is never set on a deployed Worker.
# Leave unset to give every address a random code.
DEV_FIXED_OTP_EMAIL=logan@example.com
